#version 450
// Doubles every element of a storage buffer in place.
// Bound as: descriptor set 0, binding 0, a single SSBO of uint32_t.
// Used by test/test_compute.ml (DESIGN.md §12) with a 1024-element buffer
// dispatched as ceil(1024 / 64) = 16 workgroups.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) buffer DataBuffer {
    uint data[];
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    // Guard against invocations past the end of the bound buffer range: the
    // dispatch is rounded up to a whole number of 64-wide workgroups, and the
    // buffer's element count need not be a multiple of 64. data.length() is
    // the runtime-array length derived from the actual bound buffer size, so
    // this stays correct for any buffer length, not just 1024.
    if (idx < data.length()) {
        data[idx] = data[idx] * 2u;
    }
}
