# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml bindings to the Vulkan graphics and compute API"
description:
  "Complete, generated bindings to Vulkan (core 1.0-1.4 and all registry extensions) built on ctypes. Provides a faithful raw layer plus an ergonomic OCaml layer with labelled struct constructors, lists instead of count/pointer pairs and exceptions for VkResult errors. Loads libvulkan at runtime, no C stubs or headers required."
maintainer: ["Lloyd Williams"]
authors: ["Lloyd Williams"]
license: "GPL-3.0-only"
tags: ["vulkan" "graphics" "gpu" "compute" "bindings" "ctypes"]
homepage: "https://github.com/lloyd-g-w/ocaml-vulkan"
doc: "https://github.com/lloyd-g-w/ocaml-vulkan"
bug-reports: "https://github.com/lloyd-g-w/ocaml-vulkan/issues"
depends: [
  "dune" {>= "3.10"}
  "ocaml" {>= "4.14"}
  "ctypes" {>= "0.20"}
  "ctypes-foreign" {>= "0.20"}
  "integers"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/lloyd-g-w/ocaml-vulkan.git"
